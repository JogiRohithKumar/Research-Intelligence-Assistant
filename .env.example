# =====================================================================
# Research Intelligence Assistant V2 - Environment Configuration Example
# Copy this file to .env and supply your local development credentials.
# NEVER commit the actual .env file or any real API keys to version control.
# =====================================================================

# Application Environment (development | testing | production)
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Database Configuration (PostgreSQL in production, SQLite fallback in local development)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/research_assistant
DATABASE_FALLBACK_SQLITE=true
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Authentication & JWT Configuration
AUTH_ENABLED=true
JWT_SECRET_KEY=your_production_grade_jwt_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Key Security (legacy/machine authentication)
API_KEY_ENABLED=false
ALLOWED_API_KEYS=["your_secure_api_key_here"]

# Rate Limiting & Concurrency Controls
RATE_LIMIT_ENABLED=true
MAX_CONCURRENT_RESEARCH_JOBS_PER_USER=2
MAX_CONCURRENT_RESEARCH_JOBS_GLOBAL=10
MAX_RESEARCH_TIMEOUT_SECONDS=300

# Frontend / CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
